# Vite reads frontend/.env.local. Keep API keys out of committed files.
VITE_API_URL=http://localhost:8000
VITE_FORECAST_MODE=prototype

# MapTiler is selected automatically when VITE_MAP_API_KEY is set.
VITE_MAP_API_KEY=

# For a different tile provider, use its tile URL template and attribution.
# Replace {apiKey} with the provider's key query parameter placeholder.
# VITE_MAP_TILE_URL=https://tiles.example.com/{z}/{x}/{y}.png?key={apiKey}
# VITE_MAP_ATTRIBUTION=Map data attribution required by your provider